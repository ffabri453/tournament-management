# Puerto HTTP local del backend.
PORT=3000

# PostgreSQL local. DB_NAME, DB_USER y DB_PASSWORD coinciden con Docker Compose.
# La contrasena 1234 es solo para desarrollo local; no debe usarse en produccion.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=torneos_db
DB_USER=postgres
DB_PASSWORD=1234

# Secreto aleatorio de al menos 32 bytes. Generarlo en backend/.env; no publicarlo.
JWT_SECRET=
