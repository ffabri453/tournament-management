meta {
  name: Update team
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/teams/{{teamId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "tournament_id": {{tournamentId}},
    "name": "Updated Team {{teamId}}",
    "players_count": 7
  }
}
