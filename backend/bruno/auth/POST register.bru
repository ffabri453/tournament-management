meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Tournament Organizer",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "role": "organizer"
  }
}

script:pre-request {
  const authRunId = Date.now() + "-" + Math.floor(Math.random() * 100000);
  bru.setVar("userEmail", "organizer." + authRunId + "@example.test");
  bru.setVar("userPassword", "Tm!" + authRunId + "Aa");
}
