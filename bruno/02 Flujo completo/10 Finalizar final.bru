meta {
  name: 10 Finalizar final
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/matches/{{finalId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tournament_id": {{flowTournamentId}},
    "home_team_id": {{finalHomeId}},
    "away_team_id": {{finalAwayId}},
    "match_date": "{{resultDate}}",
    "location": "Venado Tuerto",
    "round": "final",
    "status": "finished",
    "home_goals": 3,
    "away_goals": 1
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("championId", res.getBody().data.winner_team_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
