meta {
  name: 08 Finalizar semifinal 2
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/matches/{{semi2Id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tournament_id": {{flowTournamentId}},
    "home_team_id": {{semi2HomeId}},
    "away_team_id": {{semi2AwayId}},
    "match_date": "{{resultDate}}",
    "location": "Venado Tuerto",
    "round": "semi_final",
    "status": "finished",
    "home_goals": 1,
    "away_goals": 1,
    "home_penalties": 4,
    "away_penalties": 5
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Gana el visitante por penales", function () { expect(res.getBody().data.winner_team_id).to.equal(Number(bru.getVar("semi2AwayId"))); });
}
