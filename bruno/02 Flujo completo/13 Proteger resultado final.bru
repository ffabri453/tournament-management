meta {
  name: 13 Proteger resultado final
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/matches/{{finalId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tournament_id": {{flowTournamentId}},
    "home_team_id": {{finalHomeId}},
    "away_team_id": {{finalAwayId}},
    "match_date": "{{resultDate}}",
    "location": "Venado Tuerto",
    "round": "final",
    "status": "finished",
    "home_goals": 0,
    "away_goals": 1
  }
}

tests {
  test("HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
