meta {
  name: 06 Iniciar torneo
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/tournaments/{{flowTournamentId}}/start
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "match_date": "{{futureDate}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const matches = res.getBody().data.matches;
    matches.forEach(function (match, index) {
      bru.setVar("semi" + (index + 1) + "Id", match.id);
      bru.setVar("semi" + (index + 1) + "HomeId", match.home_team_id);
      bru.setVar("semi" + (index + 1) + "AwayId", match.away_team_id);
    });
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Dos semifinales", function () { expect(res.getBody().data.matches.length).to.equal(2); expect(res.getBody().data.tournament.status).to.equal("in_progress"); });
}
