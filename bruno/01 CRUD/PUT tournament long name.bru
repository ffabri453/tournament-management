meta {
  name: PUT tournament long name
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/tournaments/{{crudTournamentId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error de validacion", function () { expect(res.getBody().errors).to.be.an("array"); });
}
