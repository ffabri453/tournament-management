meta {
  name: PUT match
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/matches/{{crudMatchId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tournament_id": {{crudTournamentId}},
    "home_team_id": {{crudHomeId}},
    "away_team_id": {{crudAwayId}},
    "match_date": "{{futureDate}}",
    "location": "Cancha Dos",
    "round": "quarter_final",
    "status": "scheduled"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
