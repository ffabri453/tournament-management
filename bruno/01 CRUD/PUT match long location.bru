meta {
  name: PUT match long location
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/matches/{{crudMatchId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tournament_id": {{crudTournamentId}},
    "home_team_id": {{crudHomeId}},
    "away_team_id": {{crudAwayId}},
    "match_date": "{{futureDate}}",
    "location": "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC",
    "round": "quarter_final",
    "status": "scheduled"
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error de validacion", function () { expect(res.getBody().errors).to.be.an("array"); });
}
